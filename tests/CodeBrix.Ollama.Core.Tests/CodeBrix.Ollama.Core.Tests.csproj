<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the SHARED project. Everything in CodeBrix.Ollama.Core is internal, so this assembly is one
    of the names in that project's InternalsVisibleTo.cs. It references the shared project and NOTHING else
    of this repository's: not either library, not another test project. Offline throughout - no gate, no
    network, no interpreter - because the codec reads files and nothing more.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Ollama.Core.Tests</AssemblyName>
    <RootNamespace>CodeBrix.Ollama.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>

  <!--
    xunit.runner.json configures the runner (no parallel test collections; tests may share on-disk
    state). It only takes effect when it sits beside the test assembly, so it is copied explicitly.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Ollama.Core\CodeBrix.Ollama.Core.csproj" />
  </ItemGroup>

  <!--
    The ONNX oracle fixtures, which are this project's OWN COPY of them. The quantizer stayed in
    CodeBrix.Ollama.ModelManager when the codec moved here and its tests read the same files, but a test
    project does not read another test project's assets, so each keeps its own set. Both sets come out of the
    same generate_fixtures.py, which travels with them and records how they were made; README.txt beside it
    says what they are and who owns them. Neither copy is generated by a test.
  -->
  <ItemGroup>
    <None Update="Onnx\Fixtures\*.onnx;Onnx\Fixtures\*.data;Onnx\Fixtures\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
