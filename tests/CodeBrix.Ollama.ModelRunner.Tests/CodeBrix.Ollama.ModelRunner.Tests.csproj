<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>

  <!--
    xunit.runner.json configures the runner (no parallel test collections; tests may share on-disk
    state). It only takes effect when it sits beside the test assembly, so it is copied explicitly.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Ollama.ModelRunner\CodeBrix.Ollama.ModelRunner.csproj" />
  </ItemGroup>

  <!--
    The conformance model and its expected results are read straight out of llama-native-tools/test-vectors,
    the same folder the native builds check themselves against. They are linked rather than copied so there
    is exactly one set of them in the repository and the managed binding and the native builds can never
    drift on to different vectors.
  -->
  <ItemGroup>
    <Content Include="..\..\llama-native-tools\test-vectors\*.gguf;..\..\llama-native-tools\test-vectors\EXPECTED.txt">
      <Link>test-vectors\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
