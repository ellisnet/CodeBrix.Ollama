<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>

  <!--
    xunit.runner.json configures the runner (no parallel test collections; tests may share on-disk
    state). It only takes effect when it sits beside the test assembly, so it is copied explicitly.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Ollama.ModelRunner\CodeBrix.Ollama.ModelRunner.csproj" />
  </ItemGroup>

  <!--
    The conformance model and its expected results are read straight out of llama-native-tools/test-vectors,
    the same folder the native builds check themselves against. They are linked rather than copied so there
    is exactly one set of them in the repository and the managed binding and the native builds can never
    drift on to different vectors.
  -->
  <ItemGroup>
    <Content Include="..\..\llama-native-tools\test-vectors\*.gguf;..\..\llama-native-tools\test-vectors\EXPECTED.txt">
      <Link>test-vectors\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Test fixtures (real chat templates, expected renderings, parser inputs) live under Fixtures/<Area>/ and are
    copied beside the test assembly.
  -->
  <ItemGroup>
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The ONNX operator oracles: one small graph per operator, its inputs, and what ONNX Runtime computed from
    them. They sit under Onnx/Fixtures/ beside the tests that read them, and they are copied beside the test
    assembly so the suite finds them without reaching anywhere. Onnx/Fixtures/README.txt says who made them
    and how; generate_fixtures.py is checked in with them and is never run by a test.
  -->
  <ItemGroup>
    <Content Include="Onnx\Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The MIDI driver's fixtures: a two-graph model small enough to check in, with the same contract as the
    published one, and the sampling masks the publisher's own generation loop uses. They sit under
    Drivers/SkyTnt/Fixtures/ beside the tests that read them and are copied beside the test assembly, so the
    whole driver - the loop, both caches, the masks and the stop conditions - is exercised with nothing
    installed and nothing downloaded. Drivers/SkyTnt/Fixtures/README.txt says who made them and how; the two
    scripts are checked in with them and are never run by a test.
  -->
  <ItemGroup>
    <Content Include="Drivers\SkyTnt\Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Drivers\MuseCoco\Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The text driver's fixtures: a single-graph bundle small enough to check in, with the same generation
    configuration, the same contributed operators and the same cache contract as the one a model builder
    writes, and what the published Python tokenizer made of a corpus. They sit under
    Drivers/CausalLm/Fixtures/ beside the tests that read them and are copied beside the test assembly, so
    the whole driver - the loop, the cache, the mask, the stop conditions and the tokenizer - is exercised
    with nothing installed and nothing downloaded. Drivers/CausalLm/Fixtures/README.txt says who made them
    and how; the script is checked in with them and is never run by a test.
  -->
  <ItemGroup>
    <Content Include="Drivers\CausalLm\Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
