<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CodeBrix.Ollama.ModelRunner</RootNamespace>
    <AssemblyName>CodeBrix.Ollama.ModelRunner</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Keep the committed native libraries out of the SDK's default item globs. Without this they arrive as
      None items with no metadata AS WELL AS through the explicit items below, and the metadata-less copies
      win, so nothing reaches the package.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);runtimes\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!-- NuGet package properties -->
  <PropertyGroup>
    <PackageId>CodeBrix.Ollama.ModelRunner.MitLicenseForever</PackageId>
    <Product>CodeBrix.Ollama.ModelRunner</Product>
    <Title>CodeBrix.Ollama.ModelRunner</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A cross-platform, zero-dependency .NET library that runs a GGUF LLM model in-process and exposes it to the application through an interface contract: completion, streaming chat, embeddings, tool calling, grammar-constrained output, tokenization, model metadata and quantizing a model file to a smaller one. Binds a self-built native inference engine through hand-written P/Invoke, with native libraries for Windows x64 and ARM64, macOS Intel and Apple Silicon, and Linux x64, ARM64 and RISC-V 64. It also runs ONNX models on a pure-managed interpreter inside the package - no ONNX runtime, no Python, no native library and no NuGet dependency, so a graph runs wherever .NET runs: tensors in by name and tensors out by name for a graph of your own, MIDI music generated from a MIDI model and streamed event by event as it is written, and text generated from an ONNX bundle through the same interface contract, with a managed byte-level byte-pair tokenizer read from the bundle's own files. No server and no external Ollama installation; pair with CodeBrix.Ollama.ModelManager to resolve model names to files, and install both packages at the same version.</Description>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Ollama</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Ollama</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>ollama;llm;gguf;inference;chat;embeddings;quantize;onnx;midi;music-generation;text-generation;ai;local-ai;native;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    THE SHARED PROJECT, WHICH TRAVELS INSIDE THIS PACKAGE RATHER THAN BESIDE IT.

    CodeBrix.Ollama.Core holds the code this library and CodeBrix.Ollama.ModelManager both need - the ONNX
    codec and its protobuf reader and writer, and the tokenizer primitives. The two libraries must never
    depend on each other, in either direction and at either level, so the shared code cannot live in one of
    them; and there is no third NuGet package, so it cannot be a dependency either. PrivateAssets="all"
    keeps it out of the generated .nuspec - this package still declares NO dependencies at all - and the
    target below puts its DLL into this package's own lib/net10.0/ folder beside this assembly. The
    ModelManager package carries its own identical copy, and an application that installs both packages at
    the same version ends up with exactly one of them.

    The family versions every package to the minute it was built and publishes them together, so the two
    copies match. When an application mixes versions anyway, the SDK silently keeps the higher-versioned
    copy and the older library would otherwise die deep inside an unrelated call; CoreContract.Require, at
    the entry points of this library that reach the shared code, turns that into a sentence that says what
    to do. See MAINTAINER-README.txt, "THE Core PROJECT".
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.Ollama.Core\CodeBrix.Ollama.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCoreInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeCoreInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <!--
    The native llama.cpp libraries (one per RID), each beside a copy of the llama.cpp LICENSE file as
    LICENSE-LlamaCpp.txt. They go into the package in the standard NuGet runtimes layout, so NuGet gives an
    application the one native for the platform it is building for, and they are ALSO copied into this
    project's own output - and into the output of anything that references the project directly - so the
    tests exercise exactly the runtimes/<rid>/native/ layout the library's own probing expects to find.

    The binaries themselves are built by llama-native-tools/ and committed; nothing here builds them.
    See MAINTAINER-README.txt.
  -->
  <ItemGroup>
    <!--
      The committed native libraries and their license files. They are kept out of the SDK's default item
      globs above and named once here.
    -->
    <_LlamaNativeLibrary Include="runtimes\**\*" />

    <!--
      Packed into the standard NuGet runtimes layout, so NuGet gives an application the one native for the
      platform it is building for.

      The package path is the BARE "runtimes/" folder. NuGet appends the item's own recursive directory and
      file name to a package path that names a folder, so spelling %(RecursiveDir) out here as well produces
      runtimes/linux-x64/native/linux-x64/native/libcodebrix_llama.so. It is the one piece of this csproj
      worth checking the package for after any change - see MAINTAINER-README.txt.
    -->
    <None Include="@(_LlamaNativeLibrary)" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

  <!--
    The same files are ALSO copied into this project's output - and into the output of anything that
    references the project directly - keeping the runtimes/<rid>/native/ layout, so the test suite exercises
    exactly the layout the library's own probing has to find rather than a flattened one that would never
    fail.

    This goes through ContentWithTargetPath rather than a second Content item because NuGet's pack collects
    None and Content together and de-duplicates by identity: a Content item for the same file would silently
    win and the natives would vanish from the package. ContentWithTargetPath feeds only the copy machinery,
    which is all that is wanted here, and it flows to referencing projects the same way an ordinary content
    item does.
  -->
  <Target Name="CodeBrixOllamaModelRunnerStageNativeLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <ContentWithTargetPath Include="@(_LlamaNativeLibrary)" TargetPath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Ollama's built-in chat templates (the .gotmpl files and their index) ship inside the assembly as embedded
    resources, so the Ollama-dialect renderer can match a model's embedded template to the built-in Ollama
    uses for it, exactly as Ollama does.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\OllamaGo\BuiltIn\**\*" />
  </ItemGroup>

</Project>
