# =============================================================================================
# Containerfile.x86_64 - the codebrix_llama build machine for linux-x64
# =============================================================================================
#
# WHAT THIS IS, AND WHY IT IS A SEPARATE STEP
#   The rule this folder exists for says the LIBRARY BUILD may not reach outside this
#   repository. Tools installed on a build machine are the one allowed exception - and this
#   file IS that installation, written down and version-pinned: it takes the digest-pinned
#   manylinux base image (gcc 14, glibc 2.28) and adds cmake and ninja. Nothing else.
#
#   Building this image is the ONLY step that uses the network. The library build afterwards
#   runs with `--network none` and cannot reach anything even if it wanted to.
#
#   build.sh builds this image the first time it is needed and reuses it after that.
#   To rebuild deliberately:   FORCE_IMAGE_REBUILD=1 ./build.sh x64
#
# EVERY VERSION HERE COMES FROM pins.env. The defaults below exist only so a hand-run
# `podman build -f Containerfile.x86_64 .` still works; build.sh always passes --build-arg.
#
#   BUILT AND USED 2026-09-15 (see BUILD-PROVENANCE.txt, linux-x64). No change was needed.
# =============================================================================================

ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
FROM ${BASE_IMAGE}

ARG CMAKE_VERSION=4.4.3
ARG NINJA_VERSION=1.13.2
ARG PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

LABEL org.opencontainers.image.title="codebrix-llama-build-x86_64"
LABEL org.opencontainers.image.description="codebrix_llama native build machine: manylinux_2_28_x86_64 + cmake + ninja"
LABEL org.opencontainers.image.source="CodeBrix.Ollama/llama-native-tools/linux/Containerfile.x86_64"

# ---------------------------------------------------------------------------------------------
# 1. Distro packages: file and xz, used by the verification gate and the staging step.
#    The apt branch is not dead code - it is what makes this file survive a future base image
#    that is Debian/Ubuntu-derived rather than AlmaLinux.
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    if command -v dnf > /dev/null 2>&1; then \
        dnf install -y --setopt=install_weak_deps=False file xz; \
        dnf clean all; \
    elif command -v apt-get > /dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends file xz-utils; \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "ERROR: no dnf and no apt-get in this image." >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------------------------
# 2. cmake + ninja, at the pinned versions, from the image's own CPython.
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    "${PYTHON_IN_IMAGE}" -m pip install --no-cache-dir "cmake==${CMAKE_VERSION}" "ninja==${NINJA_VERSION}"; \
    ln -sf "$(dirname "${PYTHON_IN_IMAGE}")/cmake" /usr/local/bin/cmake; \
    ln -sf "$(dirname "${PYTHON_IN_IMAGE}")/ninja" /usr/local/bin/ninja

# ---------------------------------------------------------------------------------------------
# 3. Prove the toolchain. A missing or too-old tool fails the IMAGE build, here, where the
#    message is obvious - not ten minutes into a library build. llama.cpp needs C++17; the
#    x64 baseline needs a compiler that accepts -mavx2 -mfma -mf16c -mbmi2.
# ---------------------------------------------------------------------------------------------
RUN set -eux; \
    echo "=== toolchain in codebrix-llama-build-x86_64 ==="; \
    grep -m1 PRETTY_NAME /etc/os-release; \
    cc --version | head -1; \
    c++ --version | head -1; \
    ld --version | head -1; \
    ldd --version | head -1; \
    cmake --version | head -1; \
    ninja --version; \
    printf '#include <vector>\n#include <string_view>\nint main(){ std::string_view s{"x"}; std::vector<int> v{1}; return (int)s.size()-(int)v.size(); }\n' > /tmp/probe.cpp; \
    c++ -std=c++17 -mavx2 -mfma -mf16c -mbmi2 -o /tmp/probe /tmp/probe.cpp; \
    /tmp/probe; \
    echo "C++17 with AVX2/FMA/F16C/BMI2 flags: ok"

WORKDIR /work
